# Frontend public environment.
# Example: VITE_SERVER_URL=https://geoduel-backend.onrender.com
VITE_SERVER_URL=
# Must be copied exactly from Supabase Project Settings > API.
# Example: VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend environment.
# CLIENT_ORIGIN can be comma-separated and should include the exact Vercel origin.
# Example: CLIENT_ORIGIN=https://geo-duel.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
ADMIN_EMAILS=
ADMIN_TOKEN=

# The backend uses PORT in production hosts such as Render, Fly.io, and Railway.
PORT=3001
